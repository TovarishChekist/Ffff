# Конфигурация Telegram-бота
# Скопируйте этот файл в .env и заполните своими значениями

# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата для обращений (используйте отрицательное число для групповых чатов)
# Пример: -1002863620257
APPEAL_CHAT_ID=your_appeal_chat_id_here

# ID чата для заявок на вступление
# Пример: -1002692926810
APPLICATION_CHAT_ID=your_application_chat_id_here

# Таймауты для API (необязательно, по умолчанию 15.0 секунд)
CONNECT_TIMEOUT=15.0
READ_TIMEOUT=15.0

# Прокси (необязательно, раскомментируйте если нужен)
# PROXY=socks5://localhost:9050

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
